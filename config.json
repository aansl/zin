{
  "listen": ":8081",
  "backends": [
    {
      "name": "auth",
      "url": "http://localhost:3001",
      "routes": [
        { "method": "POST", "pattern": "/login" },
        { "method": "GET", "pattern": "/me" },
        { "method": "GET", "pattern": "/user/{id}" }
      ]
    },
    {
      "name": "api",
      "url": "http://localhost:3002",
      "routes": [
        { "method": "GET", "pattern": "/items" },
        { "method": "POST", "pattern": "/items" },
        { "method": "GET", "pattern": "/items/{id}" }
      ]
    }
  ]
}