{
  "name": "auth",
  "url": "http://localhost:3001",
  "routes": [
    {
      "method": "POST",
      "pattern": "/login",
      "rate_limit": { "max": 5, "per": "1m", "key": "ip" },
      "timeout": "10s"
    },
    {
      "method": "GET",
      "pattern": "/me",
      "timeout": "5s"
    },
    {
      "method": "GET",
      "pattern": "/user/{id}",
      "target": "/internal/users/{id}",
      "cache": { "ttl": "30s" }
    }
  ]
}
